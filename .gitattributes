# Normalise line endings so the repo behaves the same on every OS.
* text=auto

# shell scripts must keep LF or they break on macOS/Linux
*.sh    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Windows launchers are happier with CRLF
*.vbs   text eol=crlf
*.ps1   text eol=crlf

# binary
*.ico   binary
*.png   binary
